# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Required: Google Gemini API key
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Emotion source: local full-PyTorch model on this machine.
# Path to the fine-tuned two-tower checkpoint (.pt) — required for emotion detection.
EMOTION_MODEL_PATH=../emotion-detection-action/outputs/phase2_best_calibrated.pt
# Optional: torch device for the local model (default: mps on Apple Silicon).
# EMOTION_DEVICE=mps

# Optional: override the default Gemini model for --text mode (default: gemini-3.5-flash)
# Other options: gemini-3.5-flash-lite (cheaper), gemini-3.8-flash (newest)
# GEMINI_MODEL=gemini-3.5-flash

# Optional: voice-mode Live model (default: gemini-3.8-live)
# GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional: Gemini Robotics ER model for the scene tools (default: gemini-robotics-er-2-preview)
# GEMINI_ER_MODEL=gemini-robotics-er-2-preview

# Optional: custom system prompt (single line, will override the default)
# GEMINI_SYSTEM_PROMPT=You are Reachy, a friendly robot. Be concise and warm.
